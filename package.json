{
  "name": "agent-office",
  "displayName": "Agent Office 3D",
  "description": "A realistic 3D office where your Claude Code agents come to life as animated characters",
  "version": "0.1.6",
  "publisher": "thomasarisu",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SaidislomSaidazimovv/agent-office"
  },
  "bugs": {
    "url": "https://github.com/SaidislomSaidazimovv/agent-office/issues"
  },
  "homepage": "https://github.com/SaidislomSaidazimovv/agent-office#readme",
  "keywords": [
    "claude",
    "claude code",
    "agent",
    "ai",
    "3d",
    "visualization",
    "monitor",
    "office",
    "voxel",
    "three.js"
  ],
  "galleryBanner": {
    "color": "#12151a",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.84.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "bin": {
    "agent-office": "./dist/cli.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "agent-office.showPanel",
        "title": "%cmd.showPanel%",
        "icon": "$(window)"
      },
      {
        "command": "agent-office.installHooks",
        "title": "%cmd.installHooks%",
        "icon": "$(plug)"
      },
      {
        "command": "agent-office.uninstallHooks",
        "title": "%cmd.uninstallHooks%",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "agent-office.showDiagnostics",
        "title": "%cmd.showDiagnostics%",
        "icon": "$(pulse)"
      },
      {
        "command": "agent-office.focusAgent",
        "title": "%cmd.focusAgent%",
        "icon": "$(person)"
      },
      {
        "command": "agent-office.pinAgent",
        "title": "%cmd.pinAgent%",
        "icon": "$(pin)"
      },
      {
        "command": "agent-office.openDashboard",
        "title": "%cmd.openDashboard%",
        "icon": "$(graph)"
      },
      {
        "command": "agent-office.exportReport",
        "title": "%cmd.exportReport%",
        "icon": "$(export)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "agent-office.showDiagnostics",
          "when": "view == agent-office.panelView",
          "group": "navigation@1"
        },
        {
          "command": "agent-office.installHooks",
          "when": "view == agent-office.panelView",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "panel": [
        {
          "id": "agent-office-panel",
          "title": "Agent Office",
          "icon": "$(window)"
        }
      ]
    },
    "views": {
      "agent-office-panel": [
        {
          "type": "webview",
          "id": "agent-office.panelView",
          "name": "Agent Office"
        }
      ]
    },
    "configuration": {
      "title": "Agent Office",
      "properties": {
        "agent-office.autoShowPanel": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.autoShowPanel%"
        },
        "agent-office.autoSpawnAgent": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.autoSpawnAgent%"
        },
        "agent-office.hooksEnabled": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.hooksEnabled%"
        },
        "agent-office.notifications": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.notifications%"
        },
        "agent-office.notifyOnErrors": {
          "type": "boolean",
          "default": false,
          "description": "%cfg.notifyOnErrors%"
        },
        "agent-office.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%cfg.statusBar%"
        }
      }
    }
  },
  "scripts": {
    "vscode:uninstall": "node ./dist/uninstall.js",
    "check-types": "tsc -p tsconfig.json",
    "build:extension": "node esbuild.mjs",
    "build:webview": "npm --prefix webview-ui run build",
    "build": "npm run check-types && npm run build:extension && npm run build:webview",
    "test": "esbuild test/run.ts --bundle --platform=node --format=cjs --alias:vscode=./test/vscodeMock.ts --alias:three=./webview-ui/node_modules/three --outfile=.test-out.cjs --log-level=error && node .test-out.cjs",
    "watch:extension": "node esbuild.mjs --watch",
    "cli": "node dist/cli.js",
    "install:all": "npm install && npm --prefix webview-ui install",
    "package": "npm run check-types && node esbuild.mjs --production && npm run build:webview && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.84.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "ws": "^8.21.3"
  }
}
